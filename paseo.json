{
	"$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
	"worktree": {
		"setup": [
			"npm ci",
			"if [ -f \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" ]; then cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env\" .env; fi"
		]
	},
	"scripts": {
		"web": {
			"type": "service",
			"command": "npm run dev -- --host \"$HOST\" --port \"$PASEO_PORT\""
		},
		"test": {
			"command": "npm run test:unit -- --run"
		},
		"check": {
			"command": "npm run check"
		}
	}
}
